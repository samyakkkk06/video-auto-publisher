# =====================================================================
# COPY THIS FILE TO ".env" AND FILL IN YOUR KEYS
# Every value here comes from a FREE tier. Nothing here costs money.
# =====================================================================

# ---------------------------------------------------------------------
# AI TEXT GENERATION (pick ONE or more - the system tries them in order)
# ---------------------------------------------------------------------

# Google Gemini free tier -> https://aistudio.google.com/apikey
# Free tier: 1500 requests/day, no credit card needed. Best free option.
GEMINI_API_KEY=
# Optional: force a model. Leave empty to auto pick the best available flash model.
GEMINI_MODEL=

# Groq free tier -> https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter free models -> https://openrouter.ai/keys
# Free tier: 50 requests/day across all :free models, resets 00:00 UTC.
# Add 10 credits once at https://openrouter.ai/settings/credits for 1000/day.
OPENROUTER_API_KEY=
# Optional: force one model. Leave empty to auto pick a working free one.
OPENROUTER_MODEL=

# ---------------------------------------------------------------------
# ANY OPENAI-COMPATIBLE GATEWAY (NaraRouter, OpenAI, Together, self hosted)
# ---------------------------------------------------------------------
# NaraRouter      : https://router.bynara.id/v1
# OpenAI          : https://api.openai.com/v1
# Together AI     : https://api.together.xyz/v1
# Leave the whole block empty to skip this provider.
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
# Leave empty to auto pick a model from /models
CUSTOM_AI_MODEL=
# Header name and prefix. Most gateways use: Authorization / "Bearer "
# Some use: api-key / ""  (no prefix)
CUSTOM_AI_AUTH=Authorization
CUSTOM_AI_AUTH_PREFIX=Bearer 

# ---------------------------------------------------------------------
# YOUTUBE (Google Cloud project + OAuth)
# ---------------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# How to get the refresh token: run  python scripts/youtube_auth.py
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------------
# INSTAGRAM (Meta developer app)
# ---------------------------------------------------------------------
# https://developers.facebook.com/apps
# Your Instagram Business/Creator account id (numeric)
INSTAGRAM_USER_ID=
# Meta access token with instagram_basic + instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=

# ---------------------------------------------------------------------
# MEDIA HOSTING FOR INSTAGRAM
# Instagram must download your video from a PUBLIC https URL.
# GitHub Releases is free and unlimited for this. -> see README "Step 6"
# ---------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ---------------------------------------------------------------------
# NOTIFICATIONS (optional but recommended)
# ---------------------------------------------------------------------
# Telegram bot for "post published" alerts: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
